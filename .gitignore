# Dependencies
node_modules/

# Build output is committed on purpose: the DSH runtime installs a bundle from
# the repository and does not run a build step, so `lib/` must ship. See README.

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test and tool caches
coverage/
.vitest/
*.tsbuildinfo

# Local environment
.env
.env.*
!.env.example

# Pre-edit backups taken during a repair. Local recovery only; the same content
# is in git history, so committing them would double every diff.
.bak-*/
*.bak-*
